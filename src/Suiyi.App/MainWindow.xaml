<Window x:Class="Suiyi.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="随译 · 聊天翻译" Style="{StaticResource {x:Type Window}}" Width="700" Height="790" MinWidth="600" MinHeight="620" WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_KeyDown" Closing="Window_Closing">
 <Grid Margin="22,18,22,14">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Grid.Row="0" Margin="0,0,0,14">
   <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="术语表" Click="Glossary_Click"/><Button Content="设置" Click="Settings_Click"/></StackPanel>
   <StackPanel><TextBlock Text="随译" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="把沟通说清楚" Foreground="#60786F" Margin="0,3,0,0"/></StackPanel>
  </DockPanel>
  <Border Grid.Row="1" Background="#E4F2EC" CornerRadius="7" Padding="12,9" Margin="0,0,0,14"><TextBlock x:Name="ModeText" TextWrapping="Wrap" Foreground="#306553"/></Border>
  <Grid Grid.Row="2" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.3*"/><ColumnDefinition Width=".65*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="原文语言" Margin="0,0,0,5"/><ComboBox x:Name="SourceCombo" SelectionChanged="Options_Changed"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="译成" Margin="0,0,0,5"/><ComboBox x:Name="TargetCombo" SelectionChanged="Options_Changed"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="风格" Margin="0,0,0,5"/><ComboBox x:Name="ToneCombo" SelectionChanged="Options_Changed"/></StackPanel>
  </Grid>
  <StackPanel Grid.Row="3">
   <DockPanel Margin="0,0,0,6"><TextBlock x:Name="DetectedText" Text="输入聊天内容" VerticalAlignment="Center"/><TextBlock x:Name="CountText" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#60786F"/></DockPanel>
   <TextBox x:Name="InputBox" AutomationProperties.Name="聊天原文" Height="146" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False" InputMethod.IsInputMethodEnabled="True" TextChanged="Input_Changed" MaxLength="20000"/>
   <DockPanel Margin="0,10,0,14">
    <Button DockPanel.Dock="Right" Content="翻译  Ctrl+Enter" Background="#087F69" Foreground="White" BorderBrush="#087F69" Click="Translate_Click"/>
    <StackPanel Orientation="Horizontal"><Button Content="粘贴" Click="Paste_Click" Margin="0,0,4,0"/><Button Content="清空" Click="Clear_Click"/><Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False"/><Button Content="重试" Click="Translate_Click"/></StackPanel>
   </DockPanel>
  </StackPanel>
  <Border Grid.Row="4" Background="White" CornerRadius="8" BorderBrush="#DAE5DF" BorderThickness="1" Padding="14">
   <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel>
     <StackPanel x:Name="OptimizedPanel" Visibility="Collapsed" Margin="0,0,0,18">
      <DockPanel><Button Content="复制中文" DockPanel.Dock="Right" Click="CopyChinese_Click"/><TextBlock Text="优化中文" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
      <TextBox x:Name="OptimizedBox" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Margin="0,7,0,0" Padding="0"/>
     </StackPanel>
     <DockPanel Margin="0,0,0,12"><Button x:Name="CopyButton" Content="复制译文" DockPanel.Dock="Right" Click="CopyAll_Click" IsEnabled="False"/><TextBlock x:Name="ResultTitle" Text="译文" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
     <TextBlock x:Name="EmptyText" Text="译文会显示在这里。&#10;中文输入会同时显示轻度优化后的中文。" TextWrapping="Wrap" Foreground="#7B8E85" Margin="0,14,0,18"/>
     <StackPanel x:Name="SegmentsPanel"/>
    </StackPanel>
   </ScrollViewer>
  </Border>
  <StackPanel Grid.Row="5" Margin="0,12,0,0"><TextBlock x:Name="StatusText" Text="准备就绪" TextWrapping="Wrap" Foreground="#306553"/><TextBlock x:Name="FooterText" FontSize="11" Foreground="#7B8E85" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
 </Grid>
</Window>
